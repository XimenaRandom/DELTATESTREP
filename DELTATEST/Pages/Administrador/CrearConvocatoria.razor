@page "/administrador/convocatorias/crear"
@attribute [Authorize(Roles = "Administrador,Inspector")]
@page "/administrador/convocatorias/{Id:int}"
@page "/administrador/convocatorias/{Id:int}/editar"
@layout MainSinLayout
@using Delta.Contracts
@using System.Net
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<div class="delta-screen delta-screen-crearconvocatoria" data-page="crearconvocatoria">
<PageTitle>@Titulo</PageTitle>
<div class="container py-4 convocatoria-editor" style="max-width: 900px">
    <h1 class="h3 mt-3">@Titulo</h1>
    @if (Id.HasValue) { <a href="/administrador/convocatorias">Volver a convocatorias</a> }
    <p>Seleccione las opciones disponibles o elija Personalizado cuando necesite otro contenido. El código se asigna al guardar. La publicación será visible desde la fecha indicada. La fecha límite incluye todo ese día en Bolivia.</p>
    @if (error != null) { <div class="alert alert-danger" role="alert">@error</div> }
    @if (cargando) { <p role="status">Cargando convocatoria...</p> }
    @if (guardada)
    {
        <div class="alert alert-success" role="status">Convocatoria @form.Codigo guardada correctamente. @aviso</div>
        <a href="/administrador/convocatorias" class="btn btn-warning">Ver convocatorias</a>
        <button type="button" class="btn btn-outline-secondary" @onclick="Nueva">Crear otra</button>
    }
    else if (!cargando && !falloCarga)
    {
        <EditForm @key="form" Model="form" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <fieldset disabled="@(guardando || SoloLectura)" class="convocatoria-fields">
                <div class="mb-3">
                    <label for="Codigo" class="form-label">Código de convocatoria</label>
                    <input id="Codigo" class="form-control" value="@(string.IsNullOrWhiteSpace(form.Codigo) ? "Se asignará automáticamente al guardar" : form.Codigo)" readonly />
                </div>
                <CampoConvocatoria Id="NombreConvocatoria" Etiqueta="Título" Opciones="Titulos" @bind-Value="form.NombreConvocatoria" Maximo="255" Filas="1" />
                <ValidationMessage For="@(() => form.NombreConvocatoria)" />
                <CampoConvocatoria Id="EntidadEmisora" Etiqueta="Entidad emisora" Opciones="Entidades" @bind-Value="form.EntidadEmisora" Maximo="200" Filas="1" />
                <CampoConvocatoria Id="Resumen" Etiqueta="Resumen para la tarjeta" Opciones="Resumenes" @bind-Value="form.Resumen" Maximo="500" />
                <CampoConvocatoria Id="Descripcion" Etiqueta="Descripción" Opciones="Descripciones" @bind-Value="form.Descripcion" />
                <CampoConvocatoria Id="Objetivo" Etiqueta="Objetivo" Opciones="Objetivos" @bind-Value="form.Objetivo" />
                <CampoConvocatoria Id="Participantes" Etiqueta="Participantes convocados" Opciones="Participantes" @bind-Value="form.Participantes" />
                <CampoConvocatoria Id="Requisitos" Etiqueta="Requisitos y criterios" Opciones="Requisitos" @bind-Value="form.Requisitos" />
                <CampoConvocatoria Id="Modalidad" Etiqueta="Modalidad de evaluación" Opciones="Modalidades" @bind-Value="form.Modalidad" />
                <fieldset class="mb-3">
                    <legend class="h6">Cronograma de evaluación (hora de Bolivia)</legend>
                    @if (cronogramaAnterior)
                    {
                        <div class="form-check mb-3"><InputCheckbox id="usar-calendario" class="form-check-input" @bind-Value="usarCalendario" /><label for="usar-calendario" class="form-check-label">Reemplazar el cronograma anterior por fecha y horas</label></div>
                    }
                    @if (!cronogramaAnterior || usarCalendario)
                    {
                        <div class="row">
                            <div class="col-md-6 mb-3"><label for="fecha-evaluacion" class="form-label">Fecha de evaluación</label><InputDate id="fecha-evaluacion" min="@(form.FechaConvocatoria?.ToString("yyyy-MM-dd"))" class="form-control" @bind-Value="form.FechaEvaluacion" /></div>
                            <div class="col-md-3 mb-3"><label for="hora-inicio" class="form-label">Hora de inicio</label><InputDate id="hora-inicio" Type="InputDateType.Time" class="form-control" @bind-Value="form.HoraInicio" /></div>
                            <div class="col-md-3 mb-3"><label for="hora-fin" class="form-label">Hora de fin</label><InputDate id="hora-fin" Type="InputDateType.Time" class="form-control" @bind-Value="form.HoraFin" /></div>
                        </div>
                    }
                    else { <p class="form-control-plaintext">@form.Cronograma</p> }
                    <ValidationMessage For="@(() => form.Cronograma)" />
                </fieldset>
                <CampoConvocatoria Id="Instrucciones" Etiqueta="Instrucciones de participación" Opciones="Instrucciones" @bind-Value="form.Instrucciones" />
                <CampoConvocatoria Id="Lugar" Etiqueta="Lugar o plataforma" Opciones="Lugares" @bind-Value="form.Lugar" Maximo="500" Filas="1" />
                <CampoConvocatoria Id="Contacto" Etiqueta="Contacto o unidad responsable" Opciones="Contactos" @bind-Value="form.Contacto" Maximo="500" Filas="1" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="publicacion" class="form-label">Fecha de publicación</label>
                        <InputDate id="publicacion" class="form-control" @bind-Value="form.FechaConvocatoria" />
                        <ValidationMessage For="@(() => form.FechaConvocatoria)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="cierre" class="form-label">Fecha límite</label>
                        <InputDate id="cierre" min="@(form.FechaConvocatoria?.ToString("yyyy-MM-dd"))" class="form-control" @bind-Value="form.FechaCierre" />
                        <ValidationMessage For="@(() => form.FechaCierre)" />
                    </div>
                </div>
                <div class="mb-3">
                    <div class="form-check form-switch"><InputCheckbox id="estado" class="form-check-input" role="switch" @bind-Value="ConvocatoriaActiva" /><label class="form-check-label" for="estado">Convocatoria activa</label></div>
                    <p class="small text-muted">Al desmarcar se guarda como cerrada. La fecha límite también determina su vigencia pública.</p>
                    <ValidationMessage For="@(() => form.EstadoConvocatoria)" />
                </div>
                <div class="mb-3 form-check form-switch">
                    <InputCheckbox id="publicada" class="form-check-input" role="switch" @bind-Value="form.Publicada" />
                    <label class="form-check-label" for="publicada">Publicar convocatoria</label>
                    <p class="small text-muted">Si está desmarcado, la convocatoria solo aparece en administración. Si está marcado, será pública desde la fecha indicada.</p>
                </div>
                @if (!SoloLectura)
                {
                    <button type="submit" class="btn btn-warning">@(guardando ? "Guardando..." : "Guardar convocatoria")</button>
                }
            </fieldset>
        </EditForm>
    }
</div>


</div>
@code {
    [Parameter] public int? Id { get; set; }
    private bool SoloLectura => Id.HasValue && !new Uri(Navigation.Uri).AbsolutePath.EndsWith("/editar", StringComparison.OrdinalIgnoreCase);
    private string Titulo => !Id.HasValue ? "Crear convocatoria" : SoloLectura ? "Detalle de convocatoria" : "Editar convocatoria";
    private bool cargando, falloCarga;
    private ConvocatoriaForm form = new();
    private bool cronogramaAnterior, usarCalendario;
    private static readonly string[] Titulos = { "Convocatoria de evaluación teórica", "Convocatoria de evaluación práctica", "Convocatoria de evaluación integral" };
    private static readonly string[] Entidades = { "Laboratorios Delta S.A." };
    private static readonly string[] Resumenes = { "Evaluación de conocimientos del personal.", "Evaluación práctica de competencias.", "Evaluación teórica y práctica de competencias." };
    private static readonly string[] Descripciones = { "Se convoca al personal seleccionado a participar en una evaluación de conocimientos.", "Se convoca al personal seleccionado a demostrar sus competencias mediante una evaluación práctica.", "Se convoca al personal seleccionado a una evaluación teórica y práctica." };
    private static readonly string[] Objetivos = { "Evaluar los conocimientos relacionados con el puesto de destino.", "Evaluar las competencias prácticas relacionadas con el puesto de destino.", "Identificar fortalezas y oportunidades de mejora del personal." };
    private static readonly string[] Participantes = { "Empleados", "Pasantes", "Empleados y pasantes" };
    private static readonly string[] Requisitos = { "Contar con una cuenta activa en DELTATEST.", "Contar con una cuenta activa en DELTATEST y tener completos los datos laborales.", "Presentar la documentación indicada por el responsable de la evaluación." };
    private static readonly string[] Modalidades = { "Teórica", "Práctica", "Teórica y práctica" };
    private static readonly string[] Instrucciones = { "Ingresar a DELTATEST con la cuenta asignada y seguir las indicaciones del evaluador.", "Presentarse en el lugar y horario indicados y seguir las instrucciones del evaluador.", "Completar la evaluación teórica en DELTATEST y realizar la práctica según las indicaciones del evaluador." };
    private static readonly string[] Lugares = { "Plataforma DELTATEST", "Laboratorios Delta S.A.", "Plataforma DELTATEST y laboratorios Delta S.A." };
    private static readonly string[] Contactos = { "Inspector responsable de la evaluación", "Administración de Laboratorios Delta S.A." };
    private bool ConvocatoriaActiva { get => form.EstadoConvocatoria == "Activa"; set => form.EstadoConvocatoria = value ? "Activa" : "Cerrada"; }
    private bool guardando, guardada;
    private string? error, aviso;
    private void Nueva()
    {
        if (Id.HasValue) Navigation.NavigateTo("/administrador/convocatorias/crear");
        else { form = new(); cronogramaAnterior=false; usarCalendario=true; guardada = false; error = null; }
    }
    protected override async Task OnParametersSetAsync()
    {
        form = new(); cronogramaAnterior=false; usarCalendario=true; error = null; guardada = false; falloCarga = false;
        if (!Id.HasValue) return;
        cargando = true;
        try
        {
            using var response = await Http.GetAsync($"api/convocatorias/{Id.Value}");
            if (!response.IsSuccessStatusCode)
            {
                falloCarga = true;
                error = response.StatusCode == HttpStatusCode.NotFound ? "La convocatoria ya no existe." : "No se pudo cargar la convocatoria. Comprueba tu sesión y vuelve a intentarlo.";
                return;
            }
            form = await response.Content.ReadFromJsonAsync<ConvocatoriaForm>() ?? throw new JsonException();
            cronogramaAnterior = !form.CargarCronograma() && !string.IsNullOrWhiteSpace(form.Cronograma);
            usarCalendario = !cronogramaAnterior;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or JsonException)
        { falloCarga = true; error = "No se pudo cargar la convocatoria. Comprueba la conexión y vuelve a intentarlo."; }
        finally { cargando = false; }
    }
    private async Task Guardar()
    {
        if (guardando || SoloLectura || cargando || falloCarga) return;
        if ((!cronogramaAnterior || usarCalendario) && (!form.FechaEvaluacion.HasValue || !form.HoraInicio.HasValue || !form.HoraFin.HasValue))
        { error="Seleccione la fecha y las horas de la evaluación."; return; }
        if (cronogramaAnterior && !usarCalendario) { form.FechaEvaluacion=null; form.HoraInicio=null; form.HoraFin=null; }
        guardando = true;
        error = null;
        try
        {
            using var response = Id.HasValue
                ? await Http.PutAsJsonAsync($"api/convocatorias/{Id.Value}", form)
                : await Http.PostAsJsonAsync("api/convocatorias", form);
            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                error = "La sesión ha expirado. Inicie sesión nuevamente; conserve los datos del formulario antes de salir.";
                return;
            }
            if (response.StatusCode == HttpStatusCode.Forbidden)
            { error = "Su cuenta no tiene permisos para guardar convocatorias."; return; }
            if (response.StatusCode == HttpStatusCode.NotFound)
            { error = "La convocatoria ya no existe. Vuelve al listado para comprobarlo."; return; }
            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (body.TryGetProperty("mensaje", out var mensaje)) error = mensaje.GetString();
                else if (body.TryGetProperty("errors", out var errores))
                    error = string.Join(" ", errores.EnumerateObject().SelectMany(p => p.Value.EnumerateArray()).Select(v => v.GetString()));
                error ??= "No se pudo guardar la convocatoria. Revise los datos e intente nuevamente.";
                return;
            }
            if (!Id.HasValue)
            {
                var creada = await response.Content.ReadFromJsonAsync<JsonElement>();
                if (creada.TryGetProperty("codigo", out var codigo)) form.Codigo=codigo.GetString() ?? "";
            }
            guardada = true;
            aviso = form.Publicada ? "Será pública desde la fecha indicada; en inicio se muestran solo las tres últimas." : "La convocatoria no está publicada y solo es visible en administración.";
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or JsonException)
        { error = "No se pudo confirmar el guardado. Compruebe la conexión y el listado de convocatorias antes de reintentar."; }
        finally { guardando = false; }
    }
}
